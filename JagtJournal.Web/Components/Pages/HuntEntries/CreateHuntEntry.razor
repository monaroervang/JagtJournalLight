@page "/huntentries/create"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms

<section aria-labelledby="create-hunt-entry-heading">
	<h3 id="create-hunt-entry-heading">Opret jagtpost</h3>

	@if (!string.IsNullOrWhiteSpace(_message))
	{
		<output role="status">@_message</output>
	}

	<EditForm Model="_model" OnValidSubmit="CreateAsync">
		<!--
        EditForm er Blazors formular-komponent.
        Den arbejder sammen med Data Annotations og validerer modellen,
        før OnValidSubmit kalder CreateAsync.
    -->
		<!-- Aktiverer validering ud fra Data Annotations på DTO'en -->
		<DataAnnotationsValidator />

		<!-- Viser en samlet liste over eventuelle valideringsfejl -->
		<ValidationSummary />

		<fieldset>
			<legend>Jagtpost oplysninger</legend>

			<p>
				<label for="username">Brugernavn</label>

				<!-- Binder tekstfeltet til Username på formularens model -->
				<InputText id="username" @bind-Value="_model.Username" />

				<!-- Viser kun valideringsfejl for Username -->
				<ValidationMessage For="@(() => _model.Username)" />
			</p>

			<p>
				<label for="huntingAreaId">Jagtområde</label>

				<InputSelect id="huntingAreaId"
							 @bind-Value="_huntingAreaIdText">

					<option value="">-- Vælg jagtområde --</option>

					@foreach (var huntingArea in _huntingAreas)
					{
						<option value="@huntingArea.Id">
							@huntingArea.Name
						</option>
					}

				</InputSelect>
			</p>

			<p>
				<label for="date">Dato</label>
				<InputDate id="date" @bind-Value="_model.Date" />
				<ValidationMessage For="@(() => _model.Date)" />
			</p>

			<p>
				<label for="cartridgesUsed">Patroner brugt</label>
				<InputNumber id="cartridgesUsed"
							 @bind-Value="_model.CartridgesUsed" />
				<ValidationMessage For="@(() => _model.CartridgesUsed)" />
			</p>

			<button type="submit">Opret jagtpost</button>
		</fieldset>
	</EditForm>
</section>

